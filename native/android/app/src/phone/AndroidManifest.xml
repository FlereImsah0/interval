<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <application>
        <activity android:name=".TimerActivity" android:theme="@style/IntervalPhoneTheme"
            android:windowSoftInputMode="adjustResize" />
        <receiver android:name=".TimerWidget" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/timer_widget" />
        </receiver>
    </application>
</manifest>
